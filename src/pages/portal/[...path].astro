---
/**
 * The dashboard's old address. `/portal/<anything>?<query>` → `/dashboard/<anything>?<query>`,
 * keeping the query string: the dashboard's one-click owner sign-in into the Preview opens
 * `/portal/?owner_ticket=…`, and old links and bookmarks keep working. Keep this page.
 */
export const prerender = false;

const rest = Astro.url.pathname.replace(/^\/portal/, '');
return Astro.redirect(`/dashboard${rest}${Astro.url.search}`, 308);
---
